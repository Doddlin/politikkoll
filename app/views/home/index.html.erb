<% content_for :title, t("layout.title") %>

<main class="page home">
  <header class="top slim">
    <div class="wordmark">politikkoll</div>
    <%= render "shared/locale_switcher" %>
  </header>

  <% if @ongoing_conversation %>
    <%= link_to new_chat_path, class: "resume-banner" do %>
      <%= t("home.resume_banner") %> <span>→</span>
    <% end %>
  <% end %>

  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow"><%= t("home.hero.eyebrow") %></p>
      <h1 class="hero-headline"><%= t("home.hero.headline") %></h1>
      <p class="hero-subhead"><%= t("home.hero.subhead") %></p>
      <div class="hero-actions">
        <%= link_to t("home.hero.cta"), new_chat_path, class: "cta-primary" %>
        <a href="#explore" class="scroll-hint"><%= t("home.hero.scroll_hint") %></a>
      </div>
    </div>
    <figure class="hero-figure">
      <%= image_tag "riksdagshuset-bridge.jpg", alt: "Riksdagshuset, Sveriges riksdag, i Stockholm" %>
      <figcaption>
        <%= link_to t("home.hero.photo_credit", name: "Philip Myrtorp"), "https://unsplash.com/@philipmyr?utm_source=politikkoll&utm_medium=referral", target: "_blank", rel: "noopener" %>
      </figcaption>
    </figure>
  </section>

  <div class="numbers-band">
    <div class="numbers-inner">
      <p class="numbers-heading"><%= t("home.numbers.heading") %></p>
      <div class="numbers-grid">
        <div class="number-item">
          <p class="big-number"><%= number_with_delimiter(@big_numbers[:documents], delimiter: " ") %></p>
          <p class="number-label"><%= t("home.numbers.documents") %></p>
        </div>
        <div class="number-item">
          <p class="big-number accent"><%= number_with_delimiter(@big_numbers[:searchable], delimiter: " ") %></p>
          <p class="number-label"><%= t("home.numbers.searchable") %></p>
        </div>
        <div class="number-item">
          <p class="big-number"><%= number_with_delimiter(@big_numbers[:members], delimiter: " ") %></p>
          <p class="number-label"><%= t("home.numbers.members") %></p>
        </div>
        <div class="number-item">
          <p class="big-number"><%= @big_numbers[:votes] %></p>
          <p class="number-label"><%= t("home.numbers.votes") %></p>
        </div>
      </div>
    </div>
  </div>

  <section class="section features">
    <p class="section-heading"><%= t("home.features.heading") %></p>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none"><path d="M7 17V7m0 10-3-3m3 3 3-3M17 7v10m0-10 3 3m-3-3-3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <p class="feature-title"><%= t("home.features.compare.title") %></p>
        <p class="feature-body"><%= t("home.features.compare.body") %></p>
        <%= button_to t("home.features.compare.cta"), chat_path, params: { question: t("home.features.compare.question") }, class: "feature-cta" %>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <p class="feature-title"><%= t("home.features.topic.title") %></p>
        <p class="feature-body"><%= t("home.features.topic.body") %></p>
        <%= button_to t("home.features.topic.cta"), chat_path, params: { question: t("home.features.topic.question") }, class: "feature-cta" %>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="13" y="4" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="4" y="13" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/><path d="m15 16.5 1.8 1.8L20.5 14.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <p class="feature-title"><%= t("home.features.vote.title") %></p>
        <p class="feature-body"><%= t("home.features.vote.body") %></p>
        <%= button_to t("home.features.vote.cta"), chat_path, params: { question: t("home.features.vote.question") }, class: "feature-cta" %>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="2"/></svg>
        </div>
        <p class="feature-title"><%= t("geography.home_card.title") %></p>
        <p class="feature-body"><%= t("geography.home_card.body") %></p>
        <%= link_to t("geography.home_card.cta"), geography_path, class: "feature-cta" %>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none"><path d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0V4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M17 5.5h2a2 2 0 0 1 0 4h-.3M7 5.5H5a2 2 0 0 0 0 4h.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <p class="feature-title"><%= t("insights.home_card.title") %></p>
        <p class="feature-body"><%= t("insights.home_card.body") %></p>
        <%= link_to t("insights.home_card.cta"), insights_path, class: "feature-cta" %>
      </div>
    </div>
  </section>

  <section class="section" id="explore">
    <p class="section-heading"><%= t("home.explore_heading") %></p>
    <%= render "shared/suggestion_chips", questions: suggested_questions %>
  </section>

  <% if @explorable_motions.any? %>
    <section class="section">
      <div class="section-heading-row">
        <p class="section-heading"><%= t("home.motions_heading") %></p>
        <%= link_to t("documents.browse_all"), documents_path, class: "browse-all-link" %>
      </div>
      <p class="section-hint"><%= t("home.motions_hint") %></p>

      <div class="motion-grid">
        <% @explorable_motions.each do |motion| %>
          <% party = @parties_by_code[motion.party_code] %>
          <%= link_to document_path(motion), class: "motion-card" do %>
            <span class="motion-party" style="background: <%= party&.color || "var(--ink-faint)" %>">
              <%= party ? motion.party_code : t("home.multiple_parties") %>
            </span>
            <span class="motion-title"><%= motion.titel %></span>
            <span class="motion-meta"><%= motion.beteckning %> · <%= motion.published_at&.strftime("%-d %b %Y") %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="closing-cta">
    <p class="closing-heading"><%= t("home.closing.heading") %></p>
    <%= link_to t("home.closing.cta"), new_chat_path, class: "cta-primary" %>
  </section>
</main>
