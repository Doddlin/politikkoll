<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <% page_title = content_for(:title) || t("seo.default_title") %>
    <% page_description = content_for(:description) || t("seo.default_description") %>
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="<%= request.original_url.split("?").first %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Politikkoll">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Open Graph — social share previews (Slack, Facebook, LinkedIn, etc). %>
    <meta property="og:site_name" content="politikkoll">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= request.original_url.split("?").first %>">
    <meta property="og:image" content="<%= image_url("riksdagshuset-bridge.jpg") %>">
    <meta property="og:locale" content="<%= I18n.locale == :sv ? "sv_SE" : "en_US" %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= image_url("riksdagshuset-bridge.jpg") %>">

    <%# WebSite structured data — helps search engines understand what this
        is; deliberately not claiming any SearchAction/sitelinks-searchbox
        since there's no site-wide free-text search to point it at. %>
    <script type="application/ld+json">
      <%== {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "politikkoll",
        "url": root_url,
        "description": t("seo.default_description"),
        "inLanguage": [ "sv", "en" ]
      }.to_json %>
    </script>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Propshaft doesn't process ERB inside .css files, so @font-face (which
        needs asset_path for the fingerprinted font URL) lives here instead. %>
    <style>
      @font-face {
        font-family: 'Archivo';
        font-weight: 400 900;
        font-style: normal;
        font-display: swap;
        src: url(<%= asset_path("archivo-variable.woff2") %>) format('woff2');
      }
      @font-face {
        font-family: 'Hanken Grotesk';
        font-weight: 300 700;
        font-style: normal;
        font-display: swap;
        src: url(<%= asset_path("hanken-grotesk-variable.woff2") %>) format('woff2');
      }
    </style>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>

    <% if Rails.env.production? %>
      <%# Google Analytics is NOT loaded here — the gtag.js script tag itself
          isn't injected into the page until the visitor explicitly accepts,
          via cookie_consent_controller.js. Loading Google's script
          unconditionally would already send data to Google before any
          consent decision, which defeats the point of asking. %>
      <div data-controller="cookie-consent" data-cookie-consent-measurement-id-value="G-868F00VDPQ">
        <div class="cookie-banner" data-cookie-consent-target="banner" hidden role="dialog" aria-label="<%= t("cookies.banner_aria") %>">
          <p class="cookie-banner-text"><%= t("cookies.message") %></p>
          <div class="cookie-banner-actions">
            <button type="button" class="cookie-btn decline" data-action="cookie-consent#decline"><%= t("cookies.decline") %></button>
            <button type="button" class="cookie-btn accept" data-action="cookie-consent#accept"><%= t("cookies.accept") %></button>
          </div>
        </div>
        <button type="button" class="cookie-reopen" data-cookie-consent-target="reopenLink" data-action="cookie-consent#reopen" hidden><%= t("cookies.manage") %></button>
      </div>
    <% end %>
  </body>
</html>
