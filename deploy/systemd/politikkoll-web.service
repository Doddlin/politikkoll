# Install to /etc/systemd/system/politikkoll-web.service on the target box.
#
# This box already runs two other app stacks on ports 3000 and 3001, each
# split into a web unit + a jobs unit — politikkoll follows the same
# split-unit pattern rather than the single-process SOLID_QUEUE_IN_PUMA
# layout, to stay consistent with how the box is actually run. Port 3002:
# 3000 and 3001 are both taken.
#
# Runs as the existing "deploy" user, not a new dedicated system user —
# matching how this box already deploys things.

[Unit]
Description=politikkoll Rails app (Puma)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/politikkoll
EnvironmentFile=/var/www/politikkoll.env
Environment=RAILS_ENV=production
Environment=HOME=/home/deploy
Environment=PATH=/home/deploy/.rbenv/shims:/home/deploy/.rbenv/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/home/deploy/.rbenv/shims/bundle exec puma -C config/puma.rb

Restart=on-failure
RestartSec=3
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=politikkoll-web

# This box runs multiple app stacks plus a background transcription
# service on 2 cores / 3.8GB — cap this unit so a runaway request (or a
# slow Mistral call piling up threads) can't starve the other apps. Puma
# itself is already conservative (1 worker, RAILS_MAX_THREADS=3 by default in
# config/puma.rb); MemoryMax is the backstop. Tune after watching real
# usage via `systemctl status politikkoll-web` / `journalctl`.
MemoryHigh=400M
MemoryMax=550M
CPUQuota=60%

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/politikkoll

[Install]
WantedBy=multi-user.target
