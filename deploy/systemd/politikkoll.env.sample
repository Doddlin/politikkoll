# Copy to /var/www/politikkoll.env on the target box (matching
# EnvironmentFile= in both politikkoll-web.service and politikkoll-jobs.
# service), fill in real values, then lock it down:
#   chown deploy:deploy /var/www/politikkoll.env
#   chmod 600 /var/www/politikkoll.env
# Never commit the filled-in version.

RAILS_MASTER_KEY=

# 3000 is clarifyr-web, 3001 is tikka-web — this box already runs both.
PORT=3002

# Web and jobs run as two separate systemd units on this box (matching
# clarifyr/tikka_web's own layout), so this does NOT get
# SOLID_QUEUE_IN_PUMA=true — that would start a second, redundant
# supervisor inside Puma on top of politikkoll-jobs.service.

# Same names config/database.yml already reads for the production block.
# This box's Postgres is a single shared postgresql@16-main cluster
# already serving clarifyr and tikka_web — POLITIKKOLL_DATABASE_HOST is
# almost certainly 127.0.0.1 here, not a separate managed host.
POLITIKKOLL_DATABASE_HOST=127.0.0.1
POLITIKKOLL_DATABASE_PASSWORD=

MISTRAL_API_KEY=
